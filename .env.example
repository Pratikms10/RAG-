# Leave these unset to run the fully local fallback (hash embeddings + extractive answers).
# Set both values to use OpenAI for semantic embeddings and answer synthesis.
OPENAI_API_KEY=
RAG_EMBEDDING_BACKEND=auto
RAG_ANSWER_BACKEND=auto
RAG_DATA_DIR=data
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_OPENAI_CHAT_MODEL=gpt-4.1-mini
